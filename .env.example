# Server-only. Never prefix these with NEXT_PUBLIC_: the browser never talks
# to Supabase directly (BFF), so the key must not end up in client bundles.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Public origin of the site, used for auth redirects and metadata.
SITE_URL=http://localhost:3000
